<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASMForge.App.Views.MainWindow"
        Title="ASMForge"
        Width="1450"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        KeyDown="Window_KeyDown"
        Closing="MainWindow_Closing">

  <Window.Resources>
    <!-- One memory word cell (MainWindow.MemoryCell): change highlight, tooltip and right-click actions. -->
    <DataTemplate x:Key="MemoryWordTemplate">
      <Border Background="{Binding Background}" ToolTip.Tip="{Binding Tip}" Padding="12,0">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Edit Value..." Command="{Binding EditCommand}"/>
            <MenuItem Header="Copy Value" Command="{Binding CopyValueCommand}"/>
            <MenuItem Header="Copy Address" Command="{Binding CopyAddressCommand}"/>
            <MenuItem Header="Copy Row" Command="{Binding CopyRowCommand}"/>
            <MenuItem Header="Copy ASCII" Command="{Binding CopyAsciiCommand}"/>
            <Separator/>
            <MenuItem Header="Follow Pointer" Command="{Binding FollowPointerCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*">

    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New..." InputGesture="Ctrl+N" Click="New_Click"/>
        <MenuItem Header="_Open File..." InputGesture="Ctrl+O" Click="Open_Click"/>
        <MenuItem Header="Open _Project/Folder..." InputGesture="Ctrl+Shift+O" Click="OpenFolder_Click"/>
        <Separator/>
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <MenuItem Header="_Close File" InputGesture="Ctrl+W" Click="CloseFile_Click"/>
      </MenuItem>

      <MenuItem Header="_Edit"/>

      <MenuItem Header="_Run">
        <MenuItem Header="_Assemble" InputGesture="F3" Click="Assemble_Click"/>
        <MenuItem Header="_Run / Continue" InputGesture="F5" Click="Run_Click"/>
        <MenuItem Header="Run to _Cursor" InputGesture="Ctrl+F10" Click="RunToCursor_Click"/>
        <MenuItem Header="_Pause" InputGesture="F6" Click="Pause_Click"/>
        <MenuItem Header="S_top" InputGesture="Shift+F5" Click="Stop_Click"/>
        <Separator/>
        <MenuItem Header="_Step" InputGesture="F10" Click="Step_Click"/>
        <MenuItem Name="BackMenuItem" Header="Step _Back" InputGesture="F9" Click="Back_Click"/>
        <MenuItem Header="_Reset" Click="Reset_Click"/>
        <Separator/>
        <MenuItem Header="Toggle _Breakpoint" InputGesture="Ctrl+B" Click="ToggleBreakpoint_Click"/>
        <MenuItem Header="C_lear All Breakpoints" Click="ClearBreakpoints_Click"/>
      </MenuItem>

      <MenuItem Header="_Settings">
        <MenuItem Name="ShowLineNumbersMenu"
                  Header="Show _Line Numbers"
                  ToggleType="CheckBox"
                  IsChecked="True"
                  Click="ShowLineNumbers_Click"/>
        <MenuItem Name="SyntaxHighlightingMenu"
                  Header="Syntax _Highlighting"
                  ToggleType="CheckBox"
                  IsChecked="True"
                  Click="SyntaxHighlighting_Click"/>
        <Separator/>
        <MenuItem Name="CompileAllCSharpMenu"
                  Header="Run _All Project C# Files Together"
                  ToggleType="CheckBox"
                  IsChecked="False"
                  Click="CompileAllCSharp_Click"/>
      </MenuItem>

      <MenuItem Header="_Tools"/>
      <MenuItem Header="_Help">
        <MenuItem Header="_About ASMForge" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <Border Grid.Row="1"
            Padding="8"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Button Click="New_Click">New</Button>
          <Button Click="Open_Click">Open File</Button>
          <Button Click="OpenFolder_Click">Open Project</Button>
          <Button Click="Save_Click">Save</Button>
          <Border Width="1" Margin="4,0" Background="{DynamicResource ThemeBorderLowBrush}"/>
          <Button Name="AssembleButton" Click="Assemble_Click">Assemble</Button>
          <Button Name="RunButton" Click="Run_Click" ToolTip.Tip="Run, or continue from a breakpoint/pause (F5)">Run</Button>
          <Button Name="PauseButton" Click="Pause_Click" IsEnabled="False" ToolTip.Tip="Pause the running program (F6)">Pause</Button>
          <Button Name="StopButton" Click="Stop_Click" IsEnabled="False" ToolTip.Tip="Stop and reset to the start (Shift+F5)">Stop</Button>
          <Button Name="StepButton" Click="Step_Click" ToolTip.Tip="Execute one instruction (F10)">Step</Button>
          <Button Name="BackButton" Click="Back_Click" ToolTip.Tip="Undo the last executed instruction (F9)">Back</Button>
          <Button Name="ResetButton" Click="Reset_Click">Reset</Button>
          <TextBlock Name="Status"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"
                     Text="Ready"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
          <TextBlock Text="Theme" VerticalAlignment="Center"/>
          <ComboBox Name="ThemeMode"
                    Width="105"
                    SelectedIndex="0"
                    SelectionChanged="ThemeMode_SelectionChanged">
            <ComboBoxItem Content="System"/>
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MARS-like main work area: workspace/output on the left, registers on the right.
         The GridSplitters let the user drag to resize the workspace, output, and register panels. -->
    <Grid Grid.Row="2" Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="400"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="330" MinWidth="200"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="220" MinHeight="80"/>
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0"
                  Grid.Column="0"
                  Name="WorkspaceTabs">

        <TabItem Header="EDIT">
          <Grid ColumnDefinitions="230,*">
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Margin="0,0,6,0"
                    Padding="5">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock FontWeight="Bold"
                           Text="EXPLORER"
                           Margin="5,5,5,2"/>

                <TextBlock Grid.Row="1"
                           Name="ProjectNameText"
                           FontWeight="SemiBold"
                           Margin="8,1,5,7"
                           Text="No project open"
                           TextTrimming="CharacterEllipsis"/>

                <ListBox Grid.Row="2"
                         Name="ExplorerList"
                         DoubleTapped="ExplorerList_DoubleTapped"/>
              </Grid>
            </Border>

            <Grid Grid.Column="1">
              <TabControl Name="EditorTabs"
                          SelectionChanged="EditorTabs_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="EXECUTE">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="1.15*" MinHeight="90"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="0.85*" MinHeight="90"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Padding="3">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Text Segment"
                           FontWeight="Bold"
                           Margin="6,3,6,6"/>
                <DataGrid Grid.Row="1"
                          Name="TextSegmentGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="All"
                          FontFamily="Cascadia Mono,Consolas"
                          SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120"/>
                    <!-- Machine word; hover for opcode/rs/rt/rd/shamt/funct/immediate fields and binary. -->
                    <DataGridTemplateColumn Header="Code" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Background="Transparent" Padding="12,0">
                            <ToolTip.Tip>
                              <TextBlock Text="{Binding CodeDetails}" FontFamily="Cascadia Mono,Consolas"/>
                            </ToolTip.Tip>
                            <TextBlock Text="{Binding Code}" VerticalAlignment="Center"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Basic" Binding="{Binding Basic}" Width="2*"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Row="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Padding="3">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Data Segment"
                           FontWeight="Bold"
                           Margin="6,3,6,6"/>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="4,0,4,5">
                    <!-- Stack ($sp), $gp and $fp follow their register while stepping. -->
                    <ComboBox Name="MemorySegment" Width="125" SelectedIndex="0" SelectionChanged="MemorySegment_SelectionChanged">
                      <ComboBoxItem Content="Data"/>
                      <ComboBoxItem Content="Heap"/>
                      <ComboBoxItem Content="Stack ($sp)"/>
                      <ComboBoxItem Content="$gp"/>
                      <ComboBoxItem Content="$fp"/>
                      <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="Format" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <ComboBox Grid.Column="2" Name="MemoryFormat" Width="155" SelectedIndex="0" SelectionChanged="MemoryFormat_SelectionChanged">
                      <ComboBoxItem Content="Hex"/>
                      <ComboBoxItem Content="Signed Decimal"/>
                      <ComboBoxItem Content="Unsigned Decimal"/>
                      <ComboBoxItem Content="Binary"/>
                      <ComboBoxItem Content="ASCII"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="Address / Label / $reg" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Grid.Column="4" Name="MemoryAddressBox" Text="0x10010000" FontFamily="Cascadia Mono,Consolas"/>
                    <Button Grid.Column="5" Content="Go" Margin="6,0,0,0" Click="MemoryGo_Click"/>
                  </Grid>
                  <DataGrid Grid.Row="1" Name="MemoryGrid" IsReadOnly="True" AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            HorizontalScrollBarVisibility="Auto"
                            GridLinesVisibility="All" FontFamily="Cascadia Mono,Consolas" SelectionMode="Single"
                            DoubleTapped="MemoryGrid_DoubleTapped">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="125" MinWidth="105" CanUserResize="True"/>
                      <!-- Word cells share MemoryWordTemplate: highlight, tooltip, right-click menu; double-click edits. -->
                      <DataGridTemplateColumn Header="+0" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ContentControl Content="{Binding W0}" ContentTemplate="{StaticResource MemoryWordTemplate}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+4" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ContentControl Content="{Binding W4}" ContentTemplate="{StaticResource MemoryWordTemplate}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+8" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ContentControl Content="{Binding W8}" ContentTemplate="{StaticResource MemoryWordTemplate}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+C" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ContentControl Content="{Binding WC}" ContentTemplate="{StaticResource MemoryWordTemplate}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="180" MinWidth="120" CanUserResize="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="1" Grid.Column="0" Height="6" ResizeDirection="Rows"
                    HorizontalAlignment="Stretch" Background="Transparent"/>

      <TabControl Grid.Row="2"
                  Grid.Column="0"
                  Name="OutputTabs"
                  SelectedIndex="1">
        <TabItem Header="Messages">
          <TextBox Name="Messages"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   FontFamily="Cascadia Mono,Consolas"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </TabItem>
        <TabItem Header="Run I/O">
          <Grid RowDefinitions="*,Auto">
            <TextBox Name="Console"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Mono,Consolas"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <!-- Enabled while a read syscall (5, 8, 12) waits; Enter sends the line and resumes. -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
              <TextBlock Name="InputPrompt" Text="Input" VerticalAlignment="Center" Margin="2,0,8,0"/>
              <TextBox Grid.Column="1" Name="InputBox" IsEnabled="False" FontFamily="Cascadia Mono,Consolas"
                       Watermark="Enabled when the program reads input (syscall 5, 8, 12)" KeyDown="InputBox_KeyDown"/>
              <Button Grid.Column="2" Name="InputSendButton" Content="Enter" IsEnabled="False" Margin="6,0,0,0" Click="InputSend_Click"/>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="6" ResizeDirection="Columns"
                    VerticalAlignment="Stretch" Background="Transparent"/>

      <TabControl Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="2">
        <TabItem Header="Registers">
          <Grid Margin="8" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="Bold"
                         Text="Simulated Registers"
                         VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1"
                        Name="RegisterFormat"
                        Width="150"
                        SelectedIndex="0"
                        SelectionChanged="RegisterFormat_SelectionChanged">
                <ComboBoxItem Content="Hex"/>
                <ComboBoxItem Content="Signed Decimal"/>
                <ComboBoxItem Content="Unsigned Decimal"/>
                <ComboBoxItem Content="Binary"/>
                <ComboBoxItem Content="ASCII"/>
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="1"
                       Name="PcText"
                       Margin="0,7"/>
            <ListBox Grid.Row="2"
                     Name="RegistersList"
                     FontFamily="Cascadia Mono,Consolas"
                     DoubleTapped="RegistersList_DoubleTapped">
              <ListBox.ItemTemplate>
                <!-- Registers written by the last step are highlighted, bolded, and show their previous value on hover. -->
                <DataTemplate>
                  <Border Background="{Binding Background}" ToolTip.Tip="{Binding Tip}" CornerRadius="2" Padding="4,1">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Edit Value..." Command="{Binding EditCommand}"/>
                        <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}"/>
                        <MenuItem Header="Copy Value" Command="{Binding CopyValueCommand}"/>
                        <Separator/>
                        <MenuItem Header="Show Address in Memory" Command="{Binding ShowInMemoryCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="Coproc 1">
          <TextBlock Margin="10"
                     Text="Floating-point coprocessor view will be added as MARS compatibility expands."
                     TextWrapping="Wrap"/>
        </TabItem>

        <TabItem Header="Coproc 0">
          <TextBlock Margin="10"
                     Text="Exception/status coprocessor view will be added as MARS compatibility expands."
                     TextWrapping="Wrap"/>
        </TabItem>
      </TabControl>

    </Grid>
  </Grid>
</Window>
