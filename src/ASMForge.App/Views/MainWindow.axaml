<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASMForge.App.Views.MainWindow"
        Title="ASMForge v0.8.1"
        Width="1450"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        KeyDown="Window_KeyDown"
        Closing="MainWindow_Closing">

  <Grid RowDefinitions="Auto,Auto,*">

    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New..." InputGesture="Ctrl+N" Click="New_Click"/>
        <MenuItem Header="_Open File..." InputGesture="Ctrl+O" Click="Open_Click"/>
        <MenuItem Header="Open _Project/Folder..." InputGesture="Ctrl+Shift+O" Click="OpenFolder_Click"/>
        <Separator/>
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <MenuItem Header="_Close File" InputGesture="Ctrl+W" Click="CloseFile_Click"/>
      </MenuItem>

      <MenuItem Header="_Edit"/>

      <MenuItem Header="_Run">
        <MenuItem Header="_Assemble" InputGesture="F3" Click="Assemble_Click"/>
        <MenuItem Header="_Run" InputGesture="F5" Click="Run_Click"/>
        <MenuItem Header="_Step" InputGesture="F10" Click="Step_Click"/>
        <MenuItem Name="BackMenuItem" Header="Step _Back" InputGesture="F9" Click="Back_Click"/>
        <MenuItem Header="_Reset" Click="Reset_Click"/>
      </MenuItem>

      <MenuItem Header="_Settings">
        <MenuItem Name="ShowLineNumbersMenu"
                  Header="Show _Line Numbers"
                  ToggleType="CheckBox"
                  IsChecked="True"
                  Click="ShowLineNumbers_Click"/>
        <MenuItem Name="SyntaxHighlightingMenu"
                  Header="Syntax _Highlighting"
                  ToggleType="CheckBox"
                  IsChecked="True"
                  Click="SyntaxHighlighting_Click"/>
      </MenuItem>

      <MenuItem Header="_Tools"/>
      <MenuItem Header="_Help"/>
    </Menu>

    <Border Grid.Row="1"
            Padding="8"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Button Click="New_Click">New</Button>
          <Button Click="Open_Click">Open File</Button>
          <Button Click="OpenFolder_Click">Open Project</Button>
          <Button Click="Save_Click">Save</Button>
          <Border Width="1" Margin="4,0" Background="{DynamicResource ThemeBorderLowBrush}"/>
          <Button Click="Assemble_Click">Assemble</Button>
          <Button Click="Run_Click">Run</Button>
          <Button Click="Step_Click">Step</Button>
          <Button Name="BackButton" Click="Back_Click" ToolTip.Tip="Undo the last executed instruction (F9)">Back</Button>
          <Button Click="Reset_Click">Reset</Button>
          <TextBlock Name="Status"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"
                     Text="Ready"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
          <TextBlock Text="Theme" VerticalAlignment="Center"/>
          <ComboBox Name="ThemeMode"
                    Width="105"
                    SelectedIndex="0"
                    SelectionChanged="ThemeMode_SelectionChanged">
            <ComboBoxItem Content="System"/>
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MARS-like main work area: workspace/output on the left, registers on the right.
         The GridSplitters let the user drag to resize the workspace, output, and register panels. -->
    <Grid Grid.Row="2" Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="400"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="330" MinWidth="200"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="220" MinHeight="80"/>
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0"
                  Grid.Column="0"
                  Name="WorkspaceTabs">

        <TabItem Header="EDIT">
          <Grid ColumnDefinitions="230,*">
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Margin="0,0,6,0"
                    Padding="5">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock FontWeight="Bold"
                           Text="EXPLORER"
                           Margin="5,5,5,2"/>

                <TextBlock Grid.Row="1"
                           Name="ProjectNameText"
                           FontWeight="SemiBold"
                           Margin="8,1,5,7"
                           Text="No project open"
                           TextTrimming="CharacterEllipsis"/>

                <ListBox Grid.Row="2"
                         Name="ExplorerList"
                         DoubleTapped="ExplorerList_DoubleTapped"/>
              </Grid>
            </Border>

            <Grid Grid.Column="1">
              <TabControl Name="EditorTabs"
                          SelectionChanged="EditorTabs_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="EXECUTE">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="1.15*" MinHeight="90"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="0.85*" MinHeight="90"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Padding="3">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Text Segment"
                           FontWeight="Bold"
                           Margin="6,3,6,6"/>
                <DataGrid Grid.Row="1"
                          Name="TextSegmentGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="All"
                          FontFamily="Cascadia Mono,Consolas"
                          SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="Basic" Binding="{Binding Basic}" Width="2*"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Row="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    Padding="3">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Data Segment"
                           FontWeight="Bold"
                           Margin="6,3,6,6"/>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="4,0,4,5">
                    <ComboBox Name="MemorySegment" Width="125" SelectedIndex="0" SelectionChanged="MemorySegment_SelectionChanged">
                      <ComboBoxItem Content="Data"/>
                      <ComboBoxItem Content="Heap"/>
                      <ComboBoxItem Content="Stack"/>
                      <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="Format" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <ComboBox Grid.Column="2" Name="MemoryFormat" Width="155" SelectedIndex="0" SelectionChanged="MemoryFormat_SelectionChanged">
                      <ComboBoxItem Content="Hex"/>
                      <ComboBoxItem Content="Signed Decimal"/>
                      <ComboBoxItem Content="Unsigned Decimal"/>
                      <ComboBoxItem Content="Binary"/>
                      <ComboBoxItem Content="ASCII"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="Address / Label" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Grid.Column="4" Name="MemoryAddressBox" Text="0x10010000" FontFamily="Cascadia Mono,Consolas"/>
                    <Button Grid.Column="5" Content="Go" Margin="6,0,0,0" Click="MemoryGo_Click"/>
                  </Grid>
                  <DataGrid Grid.Row="1" Name="MemoryGrid" IsReadOnly="True" AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            HorizontalScrollBarVisibility="Auto"
                            GridLinesVisibility="All" FontFamily="Cascadia Mono,Consolas" SelectionMode="Single">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="125" MinWidth="105" CanUserResize="True"/>
                      <!-- Word cells are templated so words written by the last step can be highlighted. -->
                      <DataGridTemplateColumn Header="+0" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{Binding W0.Background}" ToolTip.Tip="{Binding W0.Tip}" Padding="12,0">
                              <TextBlock Text="{Binding W0.Text}" FontWeight="{Binding W0.Weight}" VerticalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+4" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{Binding W4.Background}" ToolTip.Tip="{Binding W4.Tip}" Padding="12,0">
                              <TextBlock Text="{Binding W4.Text}" FontWeight="{Binding W4.Weight}" VerticalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+8" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{Binding W8.Background}" ToolTip.Tip="{Binding W8.Tip}" Padding="12,0">
                              <TextBlock Text="{Binding W8.Text}" FontWeight="{Binding W8.Weight}" VerticalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="+C" Width="135" MinWidth="110" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{Binding WC.Background}" ToolTip.Tip="{Binding WC.Tip}" Padding="12,0">
                              <TextBlock Text="{Binding WC.Text}" FontWeight="{Binding WC.Weight}" VerticalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="180" MinWidth="120" CanUserResize="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="1" Grid.Column="0" Height="6" ResizeDirection="Rows"
                    HorizontalAlignment="Stretch" Background="Transparent"/>

      <TabControl Grid.Row="2"
                  Grid.Column="0"
                  Name="OutputTabs"
                  SelectedIndex="1">
        <TabItem Header="Messages">
          <TextBox Name="Messages"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   FontFamily="Cascadia Mono,Consolas"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </TabItem>
        <TabItem Header="Run I/O">
          <TextBox Name="Console"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   FontFamily="Cascadia Mono,Consolas"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="6" ResizeDirection="Columns"
                    VerticalAlignment="Stretch" Background="Transparent"/>

      <TabControl Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="2">
        <TabItem Header="Registers">
          <Grid Margin="8" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="Bold"
                         Text="Simulated Registers"
                         VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1"
                        Name="RegisterFormat"
                        Width="150"
                        SelectedIndex="0"
                        SelectionChanged="RegisterFormat_SelectionChanged">
                <ComboBoxItem Content="Hex"/>
                <ComboBoxItem Content="Signed Decimal"/>
                <ComboBoxItem Content="Unsigned Decimal"/>
                <ComboBoxItem Content="Binary"/>
                <ComboBoxItem Content="ASCII"/>
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="1"
                       Name="PcText"
                       Margin="0,7"/>
            <ListBox Grid.Row="2"
                     Name="RegistersList"
                     FontFamily="Cascadia Mono,Consolas">
              <ListBox.ItemTemplate>
                <!-- Registers written by the last step are highlighted, bolded, and show their previous value on hover. -->
                <DataTemplate>
                  <Border Background="{Binding Background}" ToolTip.Tip="{Binding Tip}" CornerRadius="2" Padding="4,1">
                    <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="Coproc 1">
          <TextBlock Margin="10"
                     Text="Floating-point coprocessor view will be added as MARS compatibility expands."
                     TextWrapping="Wrap"/>
        </TabItem>

        <TabItem Header="Coproc 0">
          <TextBlock Margin="10"
                     Text="Exception/status coprocessor view will be added as MARS compatibility expands."
                     TextWrapping="Wrap"/>
        </TabItem>
      </TabControl>

    </Grid>
  </Grid>
</Window>
